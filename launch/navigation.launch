<launch>

  <!-- Backward-compatible wrapper. Prefer roslaunch mppi_bringup navigation.launch -->
  <arg name="gazebo_world_name" default="maze" />
  <arg name="joy_operation" default="true" />
  <arg name="local_planner" default="mppi_3d_a" />
  <arg name="workspace" default="$(env HOME)/mppi_swerve_drive_ros" />
  <arg name="rvizconfig" default="$(arg workspace)/data/rviz/navigation.rviz" />
  <arg name="open_rviz" default="true"/>
  <arg name="scan_topic" default="/laser_link/scan"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="odom_topic" default="/groundtruth_odom"/>
  <arg name="set_base_frame" default="base_link"/>
  <arg name="set_odom_frame" default="odom"/>
  <arg name="set_map_frame" default="map"/>
  <arg name="initial_pose_x" default="0.0"/>
  <arg name="initial_pose_y" default="0.0"/>
  <arg name="initial_pose_yaw" default="0.0"/>

  <include file="$(find mppi_bringup)/launch/navigation.launch">
    <arg name="gazebo_world_name" value="$(arg gazebo_world_name)" />
    <arg name="joy_operation" value="$(arg joy_operation)" />
    <arg name="local_planner" value="$(arg local_planner)" />
    <arg name="workspace" value="$(arg workspace)" />
    <arg name="rvizconfig" value="$(arg rvizconfig)" />
    <arg name="open_rviz" value="$(arg open_rviz)" />
    <arg name="scan_topic" value="$(arg scan_topic)" />
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)" />
    <arg name="odom_topic" value="$(arg odom_topic)" />
    <arg name="set_base_frame" value="$(arg set_base_frame)" />
    <arg name="set_odom_frame" value="$(arg set_odom_frame)" />
    <arg name="set_map_frame" value="$(arg set_map_frame)" />
    <arg name="initial_pose_x" value="$(arg initial_pose_x)" />
    <arg name="initial_pose_y" value="$(arg initial_pose_y)" />
    <arg name="initial_pose_yaw" value="$(arg initial_pose_yaw)" />
  </include>
</launch>
